# ===================================================================
# SuperUMKM Platform - Environment Configuration Template
# -------------------------------------------------------------------
# SECURITY NOTICE:
# 1. DO NOT place real API keys or secrets in this .env.example file.
# 2. Copy this file to .env and replace placeholders with real values.
# 3. Ensure .env is listed in .gitignore to prevent committing secrets.
# ===================================================================

# Server Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret Key
# SECURITY RECOMMENDATION: Generate a 64-character random hex string for production.
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_HIGH_ENTROPY_JWT_SECRET_KEY_MIN_32_CHARACTERS

# Supabase Credentials (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Enable/Disable Supabase Database Sync (true / false)
USE_SUPABASE=true
